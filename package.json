    "test:browser": "node tests/browser-smoke.mjs"
  },
  "dependencies": { "react": "19.3.0", "react-dom": "19.3.0", "lucide-react": "1.45.0" },
  "devDependencies": { "vite": "8.3.0", "@vitejs/plugin-react": "6.1.1" }
